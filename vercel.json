{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/product-scan.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/product-scan",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
